<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/void_black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="@color/void_text_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <!-- Default Camera -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/void_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Default Camera"
                    android:textColor="@color/void_text_secondary"
                    android:textSize="12sp"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="12dp" />

                <RadioGroup
                    android:id="@+id/rg_camera"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rb_cam_back"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Back Camera"
                        android:textColor="@color/void_text_primary"
                        android:buttonTint="@color/void_purple"
                        android:layout_marginBottom="8dp" />

                    <RadioButton
                        android:id="@+id/rb_cam_front"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Front Camera"
                        android:textColor="@color/void_text_primary"
                        android:buttonTint="@color/void_purple" />

                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Trigger Mode -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/void_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trigger Mode"
                    android:textColor="@color/void_text_secondary"
                    android:textSize="12sp"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="12dp" />

                <RadioGroup
                    android:id="@+id/rg_shortcut_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rb_toggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Double-press volume down"
                        android:textColor="@color/void_text_primary"
                        android:buttonTint="@color/void_accent"
                        android:layout_marginBottom="8dp" />

                    <RadioButton
                        android:id="@+id/rb_hold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hold volume key"
                        android:textColor="@color/void_text_primary"
                        android:buttonTint="@color/void_accent" />

                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Hold duration -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/void_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Hold duration"
                        android:textColor="@color/void_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_hold_ms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/void_accent"
                        android:textSize="12sp" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sb_hold_duration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="12"
                    android:progressTint="@color/void_accent"
                    android:thumbTint="@color/void_accent" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Storage info -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/void_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Storage"
                    android:textColor="@color/void_text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Recordings stay inside the app.\nUse the Save (↓) button to export to:"
                    android:textColor="@color/void_text_primary"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp" />

                <TextView
                    android:id="@+id/tv_storage_path"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="/sdcard/ShadowCap/"
                    android:textColor="@color/void_accent"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
